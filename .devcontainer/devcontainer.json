{
    "name": "BuilderGen Dev Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": ["golang.go"],
            "settings": {
                "go.toolsManagement.checkForUpdates": true,
                "go.useLanguageServer": true,
                "editor.formatOnSave": true
            }
        }
    },
    "postCreateCommand": "go mod tidy",
    "remoteUser": "root"
}
